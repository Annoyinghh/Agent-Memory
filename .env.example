# Agent-Memory Docker environment.
# Copy to .env and adjust. All values are optional with sensible defaults.

# Namespaces that cannot be wiped by clear_namespace / sync_codebase (comma list).
PROTECTED_NAMESPACES=test

# --- Optional: LLM for consolidate_memory (litellm). Leave empty to disable. ---
# Example: LLM_MODEL=gpt-4o-mini + OPENAI_API_KEY=sk-...
#          LLM_MODEL=claude-opus-4-8 + ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NOTE: NEXT_PUBLIC_API_URL is intentionally NOT used here.
# The frontend reverse-proxies /api/* to the backend via next.config.mjs rewrites,
# so the browser only needs the frontend's own host:port — no baked-in API address.
