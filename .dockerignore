# Root build context is the repo root (so backend image can COPY Agent-Memory-Graphify).
# Keep the context lean and NEVER bake the live database into an image.

# VCS / caches
.git
.gitignore
.pytest_cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Live data — mounted as a volume at runtime, never in the image
Agent-Memory-Server/data/
Agent-Memory-Server/data_backup_*
Agent-Memory-Server/graphify-out/

# Node
**/node_modules/
**/.next/

# Build artifacts
**/*.egg-info/
build/
dist/

# Other CLI skill targets (not needed in images)
.agents/
.claude/
.codex/
.gemini/
skills/

# Misc
Agent-Memory-Graphify/worked/
Agent-Memory-Graphify/graphify-benchmark/
Agent-Memory-Graphify/graphify_eval/
Agent-Memory-Graphify/graphify_test/
# NOTE: do NOT blanket-exclude *.md — graphify's package (skill*.md, always_on/*.md,
# README.md referenced by pyproject) must stay in context or setuptools build breaks.
Dockerfile*
docker-compose*.yml
.env
.env.*
